      },
      server: {
        opBreakHarvestLevel: {
          "": "Riv Blokk Samlenivå",
          "@Tooltip": "Samlenivået til Riv Blokk trylleformelen\n0 = tre, 1 = stein, 2 = jern, 3 = diamant, 4 = Netheritt.",
        },
        maxOpCount: {
          "": "Maks Antall Handlinger",
          "@Tooltip": "Maksimumantallet handlinger som kan bli gjort i ett tick, sånn at serveren ikke skal fryse.",
