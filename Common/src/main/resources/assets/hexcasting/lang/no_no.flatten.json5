          "@Tooltip": "Om å skrolle oppover vil øke nummeret til abakuset, og vice versa",
        },
        gridSnapThreshold: {
          "": "Rutenetttiltrekningsterskel",
          "@Tooltip": "I manerutenettet, lengden fra en dott musepekeren må være for at streken blir tiltrukket og kjørt gjennom den neste dotten, der 0.5 betyr 50% av veien (0.5-1)",
        },
        clickingTogglesDrawing: {
          "": "Klikking veksler på og av tegning",
          "@Tooltip": "Om du klikker for å starte og slutte å tegne, istedenfor å holde ned og dra for å tegne",
        },
        alwaysShowListCommas: {
          "": "Alltid vis listekomma",
          "@Tooltip": "Om alle iotatyper skal være separert av komma når vist i lister (Originalt bruker ikke mønsteriotaer komma)",
