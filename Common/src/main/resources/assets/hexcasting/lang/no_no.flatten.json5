        advancedTooltipsShowsIotaNBT: {
          "": "Avanserte Verktøytips viser Iota NBT",
          "@Tooltip": "Om all NBT informasjonen i Iotaer lagret I fokus og tryllebøker skal vises når Avanserte Verktøytips er påskrudd",
