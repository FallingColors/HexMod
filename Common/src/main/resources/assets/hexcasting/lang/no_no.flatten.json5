        maxSpellCircleLength: {
          "": "Maks Manesirkelstørrelse",
          "@Tooltip": "Maksimumantallet tavler én manesirkel kan bestå av",
        },
        actionDenyList: {
          "": "Forbudte Handlinger",
          "@Tooltip": "Ressursruten til forbudte handlinger. Disse handlingene vil føre til uhell hvis man prøver å bruke dem. For eksempel, hexcasting:get_caster vill forby Sinnets Refleksjon.",
        },
        circleActionDenyList: {
          "": "Forbudte Sirkelhandlinger",
          "@Tooltip": "Ressursruter til handlinger som er forbudt for manesirkler. Disse handlingene vil føre til uhell hvis man prøver å bruke dem. For eksempel, hexcasting:get_caster vill forby Sinnets Refleksjon.",
        },
        globalCostScaling: {
          "": "Global Kostskaleringsfaktor",
          "@Tooltip": "Alle mediekostnader, med unntak av handlinger merket med #hexcasting:cannot_modify_cost, vil bli ganget med dette tallet. Hvis du vil endre kostnaden på en handling med det merket, bruk den handlingsspesifikke kostnadskalalisten.",
        },
        costRescaleListRaw: {
          "": "Handlingsspesifikke Kostnadskalafaktorer",
          "@Tooltip": "Tildeler ressursposisjoner til skaleringsfaktor for den spesifikke handlingen's mediekostnad. For eksempel, hexcasting:add_motion 3 vil gjøre at Impuls koster 3x så mye medie.",
        },
        greaterTeleportSplatsItems: {
          "": "Forbedret Teleport Slipper Gjenstander",
          "@Tooltip": "Om gjenstander flyr ut av spillerens inventar når hen bruker Forbedret Teleport på seg selv",
        },
        doesTrueNameHaveAmbit: {
          "": "Om Ektenavn har omfang",
          "@Tooltip": "Om ektenavn (Enhetsreferanser til en spiller) skal tillate handlinger målrettet mot den refererte spilleren selv utenfor normalt omfang",
        },
        tpDimDenylist: {
          "": "Liste over Dimensjoner med Teleportforbud",
          "@Tooltip": "Ressursposisjoner av dimensjoner der teleportering er forbudt",
        },
        villagersOffendedByMindMurder: {
          "": "Bygdinger krenket av sinnsmord",
          "@Tooltip": "Om bygdinger skal bli sinte på spilleren når andre bygdinger er sinnsflådd",
