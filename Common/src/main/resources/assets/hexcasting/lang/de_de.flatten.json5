    category: {
      great_spells: {
        "": "",
        desc: "Die hier katalogisierten Sprüche sollen von legendärer Schwierigkeit und Macht sein. Offenbar wurden sie $(l/scroll)spärlich/$ aufgezeichnet (laut den Texten aus gutem Grund). Wahrscheinlich handelt es sich ohnehim nur um das Geschwätz vergangener Traditionalisten -- ein Zeichen ist ein Zeichen.$(br2)Was könnte schon schiefgehen?",
      },
      interop: {
        "": "",
        desc: "",
      },
      spells: {
        "": "",
        desc: "Zeichen, die die Welt magisch beeinflussen.",
      },
      patterns: {
        desc: "Eine Liste aller Zeichen, die ich entdeckt habe, sowie ihrer Wirkungen.",
        "": "Zeichen",
      },
      lore: {
        "": "Überlieferung",
        desc: "Ich habe einige Briefe und Schriften gefunden, die nicht unmittelbar mit meine Kunst zu tun haben. Dennoch glaube ich, dass ich aus ihnen vielleicht etwas von der Geschichte dieser Welt ergründen kann. Mal sehen...",
      },
      items: {
        "": "Gegenstände",
        desc: "Diesen Abschnitt widme ich den magischen und geheimnisvollen Gegenständen, denen ich im Laufe meiner Studien begegnen könnte.",
      },
      casting: {
        desc: "Ich beginne zu verstehen, wie die alten Meister ihre $(o)Sprüche$() wirken! Es ist etwas kompliziert, aber ich bin sicher, dass ich es herausfinden kann. Mal sehen...",
        "": "Sprüche Wirken",
      },
      basics: {
        desc: "Die Praktizierenden dieser Kunst wirken ihre sogenannten $(o)Sprüche$(), indem sie mit einem $(l/staff)$(item)Stab/$ seltsame Zeichen in die Luft zeichnen -- oder sie fertigen $(l/hexcasting)$(item)mächtige magische Gegenstände/$ an, die das Wirken für sie übernehmen. Wie könnte ich dasselbe tun?",
        "": "Grundlagen",
      },
      greatwork: {
        desc: "Ich habe... so viel gesehen. Ich habe... Vernichtung erlebt... Zerlegung und Wideraufbau. Ich habe gesehen, wie die Atome der Welt schrien, als sie umgekehrt und verdreht und zu Energie relegiert wurden. Ich habe gesehen, ich habe gesehen, ich habe g$(k)get stick bugged lmao/$",
        "": "Das Große Werk",
      },
    },
