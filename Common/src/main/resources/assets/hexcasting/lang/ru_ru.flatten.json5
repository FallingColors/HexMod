        greater_eq: "Если первый аргумент больше или равен второму, возвращает Истину. В противном случае возвращает Ложь.",
        less_eq: "Если первый аргумент меньше или равен второму, возвращает Истину. В противном случае возвращает Ложь.",
      },
      entities: {
        get_entity: "Преобразует позицию в стеке в сущность на этом месте (или $(thing)Ничто/$, если её там нет).",
        "get_entity/": {
